# Application
APP_NAME="Tarmeem Leave Verification"
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-string
FRONTEND_ORIGIN=http://localhost:3000

# Database. SQLite for the POV; any SQLAlchemy URL works (for example mssql+pyodbc://...)
DATABASE_URL=sqlite:///./data/tarmeem.db

# Bootstrap administrator (created or synced on every startup)
ADMIN_EMAIL=admin@tarmeem.ae
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_NAME="System Administrator"

# Customer OTP
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=5

# When Microsoft Graph is not configured, OTP codes are printed to the
# server console and shown in the UI so the flow can be demonstrated.
# Set to false once email is working.
OTP_DEV_MODE=true

# Gmail SMTP. SMTP_PASSWORD is a 16 character Google app password, not the account password.
# Leave SMTP_EMAIL empty to keep showing codes on screen.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=

# Microsoft 365 Graph API (app registration with Mail.Send application permission)
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER=

# Sessions and uploads
ACCESS_TOKEN_MINUTES=480
COOKIE_SECURE=false
MAX_UPLOAD_MB=10
